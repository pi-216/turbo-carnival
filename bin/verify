#!/usr/bin/env bash
# bin/verify — the single Tier-0 gate (PRD 0003; gate membership per PRD 0006 F3).
#
# "Done" becomes a state a machine can verify, not a claim an agent makes
# about itself. This composes the existing entry points in a fixed order
# (the rails-venture-template's order) and stops at the first failure:
#
#   bin/rubocop -> bin/brakeman --no-pager -> bundler-audit -> bin/packwerk check
#   -> erb_lint -> parity (PRD 0006 W1.4 audit, ticket #90) -> bin/rspec
#   -> cucumber + gherkin_lint (the template's condition: members while any
#   .feature files exist)
#
# Fail-closed: a gate that cannot run (missing gem, missing DB, missing
# binstub) is a FAILURE, never a pass. The rspec gate is verdict-gated, not
# exit-code-gated: rspec exits 0 on a zero-example run, and a lane that
# executes nothing must never pass (PRD 0003 finding 4).
#
# On failure: prints one line naming the failed gate, tails its output, and
# exits 1. Gate outputs are kept under the log dir printed on failure.
set -uo pipefail
cd "$(dirname "$0")/.."

LOGDIR="$(mktemp -d "${TMPDIR:-/tmp}/verify.XXXXXX")"

fail_gate() {
  local name="$1" rc="$2" reason="${3:-}"
  local log="$LOGDIR/$1.log"
  echo "VERIFY FAILED: $name (exit $rc${reason:+ — $reason})"
  echo "--- last 25 lines ($name) ---"
  tail -25 "$log" 2>/dev/null || true
  echo "full output: $log (kept for post-mortem)"
  exit 1
}

run_gate() {
  local name="$1"; shift
  echo "==> $name"
  "$@" >"$LOGDIR/$name.log" 2>&1
  local rc=$?
  if [ "$rc" -ne 0 ]; then
    fail_gate "$name" "$rc"
  fi
  echo "    ok: $name"
}

run_gate "rubocop" bin/rubocop
run_gate "brakeman" bin/brakeman --no-pager

# bundler-audit: prefer the local advisory DB; fall back to --update when the
# local check can't run (fresh clone has no DB yet) — the template's pattern.
if bundle exec bundler-audit check >/dev/null 2>&1; then
  AUDIT="bundle exec bundler-audit check"
else
  AUDIT="bundle exec bundler-audit check --update"
fi
run_gate "bundler-audit" sh -c "$AUDIT"

run_gate "packwerk" bin/packwerk check
run_gate "erb_lint" bundle exec erb_lint --lint-all

# parity: the PRD 0006 W1.4 audit (ticket #90). One line per template rail
# R1–R9 (CONFORM / GAP / DEVIATION(reason)); non-zero while any rail is in
# GAP. It boots the app (test env) for the live mechanism probes and runs
# before the long lanes so harness drift fails fast; a boot failure is a
# fail-closed probe error, never a pass.
run_gate "parity" bundle exec ruby scripts/parity_audit.rb

# rspec: AGENT_TEST=1 forces the compact signal even on a TTY, so the verdict
# line is always present and checkable (the binstub's documented agent mode).
# Success requires BOTH exit 0 AND the TESTS OK verdict — exit 0 alone also
# covers the zero-example case that rspec-core treats as success.
echo "==> rspec"
AGENT_TEST=1 bin/rspec >"$LOGDIR/rspec.log" 2>"$LOGDIR/rspec.stderr"
rc=$?
if [ "$rc" -ne 0 ]; then
  fail_gate "rspec" "$rc"
fi
if ! grep -q '^TESTS OK' "$LOGDIR/rspec.log"; then
  grep -h 'full log:' "$LOGDIR/rspec.stderr" 2>/dev/null || true
  fail_gate "rspec" 0 "verdict was not 'TESTS OK' (zero examples, unknown, or missing)"
fi
echo "    ok: rspec"
grep '^TESTS' "$LOGDIR/rspec.log" || true

# BDD lane (PRD 0006 R5 / Q2): the template's own condition — cucumber and
# gherkin_lint are gate members while any .feature files exist. The lane is
# scoped to the Rails app (config/cucumber.yml) and CI runs it too.
PASSED="rubocop, brakeman, bundler-audit, packwerk, erb_lint, parity, rspec"
if compgen -G "gherkin_specs/**/*.feature" >/dev/null; then
  run_gate "cucumber" bundle exec cucumber
  run_gate "gherkin_lint" bundle exec gherkin_lint $(ls gherkin_specs/**/*.feature)
  PASSED="$PASSED, cucumber, gherkin_lint"
fi

echo "VERIFY OK: $PASSED all passed"
exit 0
